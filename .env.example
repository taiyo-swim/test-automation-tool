# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/e2etool

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage: "local" | "s3"
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# AWS S3 (フェーズ② 以降)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Google OAuth (オプション)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack通知 (オプション) — プロジェクト別設定で上書き可
SLACK_WEBHOOK_URL=

# メール通知 (オプション) — SMTP_HOST を設定すると有効化
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E2E Tool <noreply@example.com>"
# AWS SES の場合: SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com, SMTP_USER=AKIAxxx

# AI機能 - Phase 5以降
ANTHROPIC_API_KEY=
